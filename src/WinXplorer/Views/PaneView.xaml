<UserControl x:Class="WinXplorer.Views.PaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:WinXplorer.Views"
             xmlns:wtk="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel">
    <Border x:Name="Frame" BorderThickness="0,2,0,0" BorderBrush="Transparent" Background="{DynamicResource ContentBrush}">
        <Grid x:Name="RootGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== Navigation row (moved under the tabs when "address bar on top" is on) ===== -->
            <Grid x:Name="NavRow" Margin="6,6,8,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition x:Name="SearchCol" Width="0.32*" MaxWidth="320" MinWidth="120"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource IconBtn}" Click="Back_Click" IsEnabled="{Binding CanGoBack}" ToolTip="{v:T BackTip}" MouseRightButtonUp="Back_RightUp">
                        <TextBlock Text="&#xE72B;" Style="{StaticResource Glyph}" FontSize="13"/>
                    </Button>
                    <Button x:Name="ForwardBtn" Style="{StaticResource IconBtn}" Click="Forward_Click" IsEnabled="{Binding CanGoForward}" ToolTip="{v:T ForwardTip}">
                        <TextBlock Text="&#xE72A;" Style="{StaticResource Glyph}" FontSize="13"/>
                    </Button>
                    <Button Style="{StaticResource IconBtn}" Click="Up_Click" IsEnabled="{Binding CanGoUp}" ToolTip="{v:T UpTip}">
                        <TextBlock Text="&#xE74A;" Style="{StaticResource Glyph}" FontSize="13"/>
                    </Button>
                    <Button Style="{StaticResource IconBtn}" Click="Refresh_Click" ToolTip="{v:T RefreshTip}" Margin="0,0,6,0">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" FontSize="13"/>
                    </Button>
                </StackPanel>

                <!-- Address bar: breadcrumbs, click empty space to type a path -->
                <Grid Grid.Column="1" Height="32">
                    <Border x:Name="CrumbBar" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="4"
                            MouseLeftButtonUp="CrumbBar_MouseUp" Cursor="IBeam">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Width="16" Height="16" Margin="8,0,2,0" Source="{Binding Path, Converter={StaticResource PathIcon}}"/>
                            <TextBlock Text="&#xE7F4;" Style="{StaticResource Glyph}" FontSize="14" Margin="8,0,2,0" Visibility="{Binding IsThisPC, Converter={StaticResource BoolToVis}}"/>
                            <ScrollViewer x:Name="CrumbScroll" Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" ClipToBounds="True">
                                <ItemsControl x:Name="Crumbs" Cursor="Arrow">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource IconBtn}" MinWidth="0" Padding="6,4" Click="Crumb_Click" Tag="{Binding Path}" MinHeight="26" AllowDrop="True" Drop="Crumb_Drop" DragOver="Crumb_DragOver">
                                                    <TextBlock Text="{Binding Name}"/>
                                                </Button>
                                                <Button Style="{StaticResource IconBtn}" MinWidth="0" Padding="3,4" Click="CrumbChevron_Click" Tag="{Binding Path}" MinHeight="26">
                                                    <TextBlock Text="&#xE76C;" Style="{StaticResource Glyph}" FontSize="9" Foreground="{DynamicResource FgDimBrush}"/>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock x:Name="SearchSummaryText" Grid.Column="1" Margin="6,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource FgBrush}" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <TextBox x:Name="AddressBox" Style="{StaticResource InputBox}" Visibility="Collapsed"
                             KeyDown="AddressBox_KeyDown" LostKeyboardFocus="AddressBox_LostFocus"/>
                </Grid>

                <!-- Search -->
                <Grid Grid.Column="3" Height="32">
                    <TextBox x:Name="SearchBox" Style="{StaticResource InputBox}" Padding="27,0,26,0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=120}" KeyDown="SearchBox_KeyDown"/>
                    <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="13" HorizontalAlignment="Left" Margin="9,0,0,0" Foreground="{DynamicResource FgDimBrush}"
                               Background="Transparent" Cursor="Help" ToolTip="{v:T SearchSyntaxTip}" ToolTipService.InitialShowDelay="250" ToolTipService.ShowDuration="60000"
                               MouseLeftButtonDown="SearchIcon_MouseDown"/>
                    <TextBlock x:Name="SearchHint" Text="{Binding SearchPlaceholder}" Margin="29,0,26,0" VerticalAlignment="Center" Foreground="{DynamicResource FgFaintBrush}"
                               IsHitTestVisible="False" TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="SearchClear" Style="{StaticResource IconBtn}" HorizontalAlignment="Right" MinWidth="24" MinHeight="24" Padding="4" Margin="0,0,3,0" Click="SearchClear_Click" Visibility="Collapsed">
                        <TextBlock Text="&#xE711;" Style="{StaticResource Glyph}" FontSize="10"/>
                    </Button>
                </Grid>
            </Grid>

            <!-- ===== Items ===== -->
            <Grid Grid.Row="1">
                <ListView x:Name="List" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource FgBrush}"
                          SelectionMode="Extended" IsTextSearchEnabled="True" TextSearch.TextPath="Name" AllowDrop="True"
                          ItemContainerStyle="{StaticResource FileRow}"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                          VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto" FocusVisualStyle="{x:Null}">
                    <!-- "group by date": a heading with a line, like Explorer -->
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="10,12,10,4">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" FontSize="14" Foreground="{DynamicResource FgBrush}"/>
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding ItemCount, StringFormat='  {0}'}" FontSize="12" VerticalAlignment="Bottom" Margin="0,0,0,1" Foreground="{DynamicResource FgFaintBrush}"/>
                                        <Border Height="1" Margin="12,2,0,0" VerticalAlignment="Center" Background="{DynamicResource BorderBrush}"/>
                                    </DockPanel>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListView.GroupStyle>
                    <ListView.View>
                        <GridView x:Name="Columns" AllowsColumnReorder="True">
                            <GridViewColumn x:Name="ColName" Width="340">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Tag="name" Click="Header_Click"/>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Opacity="{Binding ItemOpacity}" Margin="4,0,0,0" Background="Transparent"
                                                    ToolTip="{Binding ToolTipText}" ToolTipOpening="ItemToolTip_Opening">
                                            <Grid Margin="0,0,10,0">
                                                <Image Width="16" Height="16" Source="{Binding Icon}"/>
                                                <Border Background="#F2FFFFFF" BorderBrush="#80000000" BorderThickness="0.5" CornerRadius="2" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                        IsHitTestVisible="False" Visibility="{Binding IsLink, Converter={StaticResource BoolToVis}}" Margin="-1,0,0,-1">
                                                    <TextBlock Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="6" Foreground="#FF1A5FB4" FontWeight="Bold">
                                                        <TextBlock.RenderTransform><RotateTransform Angle="-45" CenterX="3" CenterY="3"/></TextBlock.RenderTransform>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="ColLocation" Width="260">
                                <GridViewColumn.Header><GridViewColumnHeader Tag="location"/></GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Location}" ToolTip="{Binding Location}" Foreground="{DynamicResource FgDimBrush}" TextTrimming="CharacterEllipsis" Margin="4,0,0,0"/></DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="ColModified" Width="150">
                                <GridViewColumn.Header><GridViewColumnHeader Tag="modified" Click="Header_Click"/></GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding ModifiedText}" Foreground="{DynamicResource FgDimBrush}" Margin="4,0,0,0"/></DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="ColType" Width="140">
                                <GridViewColumn.Header><GridViewColumnHeader Tag="type" Click="Header_Click"/></GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding TypeName}" Foreground="{DynamicResource FgDimBrush}" TextTrimming="CharacterEllipsis" Margin="4,0,0,0"/></DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="ColSize" Width="100">
                                <GridViewColumn.Header><GridViewColumnHeader Tag="size" Click="Header_Click" HorizontalContentAlignment="Right"/></GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding SizeText}" Foreground="{DynamicResource FgDimBrush}" HorizontalAlignment="Right" Margin="0,0,6,0"/></DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <ListBox x:Name="Tiles" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource FgBrush}" Visibility="Collapsed"
                         SelectionMode="Extended" IsTextSearchEnabled="True" TextSearch.TextPath="Name" AllowDrop="True"
                         ItemContainerStyle="{StaticResource TileItem}" Padding="6,7"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.CacheLengthUnit="Page" VirtualizingPanel.CacheLength="1" VirtualizingPanel.ScrollUnit="Pixel"
                         FocusVisualStyle="{x:Null}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <wtk:VirtualizingWrapPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="{Binding DataContext.TileWidth, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                  Height="{Binding DataContext.TileHeight, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                  Opacity="{Binding ItemOpacity}" ToolTip="{Binding ToolTipText}" ToolTipOpening="ItemToolTip_Opening">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="36"/>
                                </Grid.RowDefinitions>
                                <Grid Margin="3,4,3,2" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" StretchDirection="DownOnly"
                                           MaxWidth="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                           MaxHeight="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <!-- PSD / AI / PDF…: the format's icon in the corner, so the thumbnail isn't taken for a plain picture -->
                                    <Image Source="{Binding Badge}" Width="{Binding BadgeSize}" Height="{Binding BadgeSize}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                           Margin="0,0,-4,-4" RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False">
                                        <Image.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.5"/></Image.Effect>
                                    </Image>
                                    <Border Background="#F2FFFFFF" BorderBrush="#80000000" BorderThickness="0.5" CornerRadius="2" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                        IsHitTestVisible="False" Visibility="{Binding IsLink, Converter={StaticResource BoolToVis}}" Margin="0">
                                                    <TextBlock Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#FF1A5FB4" FontWeight="Bold">
                                                        <TextBlock.RenderTransform><RotateTransform Angle="-45" CenterX="5.5" CenterY="5.5"/></TextBlock.RenderTransform>
                                                    </TextBlock>
                                                </Border>
                                </Grid>
                                <TextBlock Grid.Row="1" Text="{Binding DisplayName}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Top" TextTrimming="CharacterEllipsis"
                                           MaxHeight="32" Margin="3,0,3,4" LineHeight="16"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- This PC: drive cards with a usage bar -->
                <ListBox x:Name="Drives" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource FgBrush}" Visibility="Collapsed"
                         SelectionMode="Extended" ItemContainerStyle="{StaticResource TileItem}" Padding="10,8"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" FocusVisualStyle="{x:Null}" AllowDrop="True">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="290" Margin="10,10" ToolTip="{Binding ToolTipText}" Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image Source="{Binding Thumbnail}" Width="44" Height="44" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                    <Grid Height="6" Margin="0,6,0,5" Visibility="{Binding HasUsage, Converter={StaticResource BoolToVis}}">
                                        <Border Background="{DynamicResource BorderBrush}" CornerRadius="3"/>
                                        <Border x:Name="bar" Background="{DynamicResource AccentBrush}" CornerRadius="3" HorizontalAlignment="Left"
                                                Width="{Binding DriveUsage, Converter={StaticResource FracWidth}, ConverterParameter=234}"/>
                                    </Grid>
                                    <TextBlock Text="{Binding SizeText}" Foreground="{DynamicResource FgDimBrush}"/>
                                </StackPanel>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding DriveAlmostFull}" Value="True">
                                    <Setter TargetName="bar" Property="Background" Value="#D13438"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ProgressBar x:Name="Loading" Height="2" VerticalAlignment="Top" IsIndeterminate="True" BorderThickness="0" Background="Transparent"
                             Foreground="{DynamicResource AccentBrush}" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
                <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,60,0,0" Foreground="{DynamicResource FgDimBrush}"
                           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420" IsHitTestVisible="False" Visibility="Collapsed"/>
                <!-- drag in empty space: selection rectangle -->
                <Canvas x:Name="MarqueeLayer" IsHitTestVisible="False" ClipToBounds="True">
                    <Border x:Name="Marquee" Visibility="Collapsed" BorderThickness="1" BorderBrush="{DynamicResource AccentBrush}" Background="{DynamicResource SelectedBrush}"/>
                </Canvas>
            </Grid>

            <!-- ===== Status ===== -->
            <Grid Grid.Row="2" Margin="12,2,8,4">
                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource FgDimBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MinHeight="22" Padding="0,3"/>
            </Grid>
            <Border x:Name="Dim" Grid.RowSpan="3" Background="Black" Opacity="0" IsHitTestVisible="False"/>
        </Grid>
    </Border>
</UserControl>
