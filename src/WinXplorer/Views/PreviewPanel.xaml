<UserControl x:Class="WinXplorer.Views.PreviewPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:WinXplorer.Views"
             xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit"
             Background="{DynamicResource SidebarBrush}">
    <UserControl.Resources>
        <Style x:Key="ValueBox" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="80"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto" MaxHeight="420"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid x:Name="Header" Margin="16,14,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Image x:Name="HeaderIcon" Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Top"/>
            <StackPanel Grid.Column="1">
                <TextBox x:Name="HeaderName" Style="{StaticResource ValueBox}" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock x:Name="HeaderType" Foreground="{DynamicResource FgDimBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Grid>

        <!-- Preview content -->
        <Grid Grid.Row="1" x:Name="Host" Margin="12,4,12,8">
            <Border x:Name="ImageFrame" CornerRadius="6" ClipToBounds="True" Visibility="Collapsed" Cursor="Hand" MouseLeftButtonUp="ImageFrame_Click" ToolTip="{v:T OpenViewerTip}">
                <Border.Background>
                    <!-- subtle checkerboard so transparent images (PNG/SVG/WebP) are visible -->
                    <DrawingBrush TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute" Opacity="0.35">
                        <DrawingBrush.Drawing>
                            <DrawingGroup>
                                <GeometryDrawing Brush="#FFFFFF" Geometry="M0,0 H2 V2 H0Z"/>
                                <GeometryDrawing Brush="#CCCCCC" Geometry="M0,0 H1 V1 H0Z M1,1 H2 V2 H1Z"/>
                            </DrawingGroup>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Border.Background>
                <Image x:Name="Img" Stretch="Uniform" StretchDirection="DownOnly" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>

            <Border x:Name="CodeFrame" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource ContentBrush}" Visibility="Collapsed">
                <ae:TextEditor x:Name="Code" IsReadOnly="True" ShowLineNumbers="True" FontFamily="{StaticResource MonoFont}" FontSize="12"
                               Background="Transparent" Foreground="{DynamicResource FgBrush}" LineNumbersForeground="{DynamicResource FgFaintBrush}"
                               HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="4"/>
            </Border>

            <Border x:Name="ArchiveFrame" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource ContentBrush}" Visibility="Collapsed" ClipToBounds="True"/>

            <Grid x:Name="MediaHost" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border CornerRadius="6" Background="Black" ClipToBounds="True">
                    <Grid>
                        <MediaElement x:Name="Media" LoadedBehavior="Manual" UnloadedBehavior="Close" ScrubbingEnabled="True" Stretch="Uniform"
                                      MediaOpened="Media_Opened" MediaEnded="Media_Ended" MediaFailed="Media_Failed"/>
                        <TextBlock x:Name="AudioGlyph" Text="&#xE8D6;" Style="{StaticResource Glyph}" FontSize="56" Foreground="#80FFFFFF" Visibility="Collapsed"/>
                    </Grid>
                </Border>
                <Grid Grid.Row="1" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PlayBtn" Style="{StaticResource IconBtn}" Click="Play_Click"><TextBlock x:Name="PlayGlyph" Text="&#xE768;" Style="{StaticResource Glyph}"/></Button>
                    <Grid Grid.Column="1" Height="4" Margin="8,0" VerticalAlignment="Center" x:Name="SeekBar" Background="Transparent" MouseLeftButtonDown="Seek_MouseDown" Cursor="Hand">
                        <Border Background="{DynamicResource BorderBrush}" CornerRadius="2"/>
                        <Border x:Name="SeekFill" Background="{DynamicResource AccentBrush}" CornerRadius="2" HorizontalAlignment="Left" Width="0"/>
                    </Grid>
                    <TextBlock Grid.Column="2" x:Name="TimeText" Foreground="{DynamicResource FgDimBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <Button Style="{StaticResource IconBtn}" Click="Mute_Click" ToolTip="{v:T MuteTip}"><TextBlock x:Name="MuteGlyph" Text="&#xE767;" Style="{StaticResource Glyph}"/></Button>
                        <!-- volume: click or drag -->
                        <Grid x:Name="VolBar" Width="72" Height="14" Margin="2,0,4,0" VerticalAlignment="Center" Background="Transparent" Cursor="Hand"
                              MouseLeftButtonDown="Vol_MouseDown" MouseMove="Vol_MouseMove" MouseLeftButtonUp="Vol_MouseUp" ToolTip="{v:T VolumeTip}">
                            <Border Height="4" Background="{DynamicResource BorderBrush}" CornerRadius="2"/>
                            <Border x:Name="VolFill" Height="4" Background="{DynamicResource AccentBrush}" CornerRadius="2" HorizontalAlignment="Left" Width="36"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Windows preview handler (PDF, Office, ...) -->
            <Border x:Name="HandlerFrame" Visibility="Collapsed" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource ContentBrush}"/>

            <StackPanel x:Name="MessagePanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="MessageGlyph" Text="&#xE8A1;" Style="{StaticResource Glyph}" FontSize="40" Foreground="{DynamicResource FgFaintBrush}"/>
                <TextBlock x:Name="Message" Text="{v:T SelectToPreview}" Foreground="{DynamicResource FgDimBrush}" Margin="0,10,0,0" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="240"/>
            </StackPanel>
        </Grid>

        <!-- Actions -->
        <WrapPanel Grid.Row="2" x:Name="Actions" Margin="12,0,12,4"/>

        <!-- Details -->
        <ScrollViewer Grid.Row="3" x:Name="Details" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,4,12,12">
            <ItemsControl x:Name="InfoList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><v:InfoColumns Columns="{Binding InfoColumnCount, RelativeSource={RelativeSource AncestorType=v:PreviewPanel}}"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="104"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Label}" Foreground="{DynamicResource FgDimBrush}" TextWrapping="Wrap" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" Style="{StaticResource ValueBox}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
