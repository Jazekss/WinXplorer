<Window x:Class="WinXplorer.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:WinXplorer.Views"
        Width="440" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BarBrush}" Foreground="{DynamicResource FgBrush}" FontFamily="{StaticResource UiFont}" FontSize="12"
        UseLayoutRounding="True">
    <StackPanel Margin="20,16,20,16">
        <TextBlock x:Name="Prompt" Margin="0,0,0,10" TextWrapping="Wrap"/>
        <TextBox x:Name="Input" Style="{StaticResource InputBox}" Height="32" KeyDown="Input_KeyDown"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="OkBtn" Style="{StaticResource AccentBtn}" Content="{v:T OK}" IsDefault="True" Click="Ok_Click" Margin="0,0,8,0"/>
            <Button Style="{StaticResource SubtleBtn}" Content="{v:T Cancel}" IsCancel="True" MinWidth="80"/>
        </StackPanel>
    </StackPanel>
</Window>
