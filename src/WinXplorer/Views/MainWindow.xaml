<Window x:Class="WinXplorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:WinXplorer.Views"
        xmlns:vm="clr-namespace:WinXplorer.ViewModels"
        Title="WinXplorer" Width="1200" Height="760" MinWidth="560" MinHeight="360"
        Background="{DynamicResource ChromeBrush}" Foreground="{DynamicResource FgBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="12"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="Manual">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- small vector glyphs for the split layout buttons -->
        <Geometry x:Key="GeoSingle">M1,1 H15 V13 H1 Z</Geometry>
        <Geometry x:Key="GeoVertical">M1,1 H15 V13 H1 Z M8,1 V13</Geometry>
        <Geometry x:Key="GeoHorizontal">M1,1 H15 V13 H1 Z M1,7 H15</Geometry>

        <DataTemplate x:Key="TabTemplate" DataType="{x:Type vm:TabViewModel}">
            <Border x:Name="bd" Width="{Binding TabWidth, RelativeSource={RelativeSource AncestorType=Window}}" Height="34" Margin="0,6,2,0" CornerRadius="8,8,0,0" Background="Transparent"
                    ToolTip="{Binding Active.Path}" MouseDown="Tab_MouseDown" MouseUp="Tab_MouseUp" AllowDrop="True" DragOver="Tab_DragOver"
                    RenderTransformOrigin="0.5,1">
                <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" From="0.5" To="1" Duration="0:0:0.2">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
                <Grid Margin="10,0,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Image x:Name="icon" Width="16" Height="16" Source="{Binding Active.Path, Converter={StaticResource PathIcon}}" Margin="0,0,8,0"/>
                    <TextBlock x:Name="glyph" Text="&#xE7F4;" Style="{StaticResource Glyph}" FontSize="14" Margin="0,0,8,0" Visibility="{Binding Active.IsThisPC, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="close" Grid.Column="2" Style="{StaticResource IconBtn}" MinWidth="24" MinHeight="24" Padding="4" Click="CloseTab_Click" ToolTip="{v:T CloseTab}">
                        <TextBlock Text="&#xE711;" Style="{StaticResource Glyph}" FontSize="10"/>
                    </Button>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="bd" Property="IsMouseOver" Value="True">
                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource TabActiveBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSettings}" Value="True">
                    <Setter TargetName="glyph" Property="Text" Value="&#xE713;"/>
                    <Setter TargetName="glyph" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="icon" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <!-- narrow tabs: close button only on the selected / hovered tab -->
                <DataTrigger Binding="{Binding TabsNarrow, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter TargetName="close" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding TabsNarrow, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                        <Condition Binding="{Binding IsSelected}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="close" Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding TabsNarrow, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                        <Condition Binding="{Binding IsMouseOver, ElementName=bd}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="close" Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="SidebarTemplate" DataType="{x:Type vm:SidebarItem}">
            <Grid>
                <Border x:Name="sep" Height="1" Margin="10,6" Background="{DynamicResource BorderBrush}" Visibility="Collapsed"/>
                <!-- titled separator (group header) -->
                <Grid x:Name="hdr" Margin="10,12,8,4" Visibility="Collapsed" Background="Transparent" ToolTip="{Binding Header}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Header}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource FgDimBrush}" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                    <Border Grid.Column="1" Height="1" Margin="8,1,0,0" Background="{DynamicResource BorderBrush}" VerticalAlignment="Center"/>
                </Grid>
                <Border x:Name="sepHint" Height="2" VerticalAlignment="Top" Background="{DynamicResource AccentBrush}" Visibility="Collapsed"/>
                <Border x:Name="bd" CornerRadius="4" Height="30" Padding="10,0,8,0" Background="Transparent" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0"
                        ToolTip="{Binding ToolTip}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="26"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Width="16" Height="16" Source="{Binding Icon}" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="pcGlyph" Text="&#xE7F4;" Style="{StaticResource Glyph}" FontSize="14" HorizontalAlignment="Left" Visibility="Collapsed"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                            <Grid Height="3" Margin="0,3,0,0" HorizontalAlignment="Left" Width="110" Visibility="{Binding HasUsage, Converter={StaticResource BoolToVis}}">
                                <Border Background="{DynamicResource BorderBrush}" CornerRadius="1.5"/>
                                <Border x:Name="usage" Background="{DynamicResource AccentBrush}" CornerRadius="1.5" HorizontalAlignment="Left"
                                        Width="{Binding Usage, Converter={StaticResource FracWidth}, ConverterParameter=110}"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                    <Setter TargetName="sep" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="bd" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                    <Setter TargetName="sep" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="hdr" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSeparator}" Value="True"/>
                        <Condition Binding="{Binding Hint}" Value="Above"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="sepHint" Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="ThisPC">
                    <Setter TargetName="pcGlyph" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <Trigger SourceName="bd" Property="IsMouseOver" Value="True">
                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding UsageAlmostFull}" Value="True">
                    <Setter TargetName="usage" Property="Background" Value="#D13438"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Hint}" Value="Into">
                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource DropBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Hint}" Value="Above">
                    <Setter TargetName="bd" Property="BorderThickness" Value="0,2,0,0"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Hint}" Value="Below">
                    <Setter TargetName="bd" Property="BorderThickness" Value="0,0,0,2"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============ Title bar with tabs ============ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Image x:Name="AppIcon" Width="18" Height="18" Margin="14,4,10,0" VerticalAlignment="Center"/>
            <!-- tabs shrink to fit; when even the minimum width doesn't fit, the strip scrolls (mouse wheel) -->
            <Grid Grid.Column="1" x:Name="TabArea">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid x:Name="TabScrollHost">
                <ScrollViewer x:Name="TabScroll" WindowChrome.IsHitTestVisibleInChrome="True" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                              PreviewMouseWheel="TabScroll_Wheel" ScrollChanged="TabScroll_ScrollChanged">
                    <ItemsControl x:Name="TabStrip" ItemTemplate="{StaticResource TabTemplate}"
                                  PreviewMouseMove="TabStrip_MouseMove" PreviewMouseLeftButtonUp="TabStrip_MouseUp" LostMouseCapture="TabStrip_LostCapture">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
                <!-- more tabs to the left / right: the strip fades out there and a badge says how many (click = scroll) -->
                <Button x:Name="TabsMoreLeft" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,6,0,0" Visibility="Collapsed"
                        WindowChrome.IsHitTestVisibleInChrome="True" Click="TabsMoreLeft_Click" Style="{StaticResource TabBadge}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE76B;" Style="{StaticResource Glyph}" FontSize="9" Margin="0,0,4,0"/>
                        <TextBlock x:Name="TabsMoreLeftText" FontSize="11" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <Button x:Name="TabsMoreRight" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,6,2,0" Visibility="Collapsed"
                        WindowChrome.IsHitTestVisibleInChrome="True" Click="TabsMoreRight_Click" Style="{StaticResource TabBadge}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TabsMoreRightText" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Text="&#xE76C;" Style="{StaticResource Glyph}" FontSize="9" Margin="4,0,0,0"/>
                    </StackPanel>
                </Button>
                </Grid>
                <Button Grid.Column="1" x:Name="NewTabBtn" WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource IconBtn}" Margin="2,6,0,0" VerticalAlignment="Center" Click="NewTab_Click" ToolTip="{v:T NewTabTip}">
                    <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" FontSize="12"/>
                </Button>
            </Grid>
            <!-- ghost shown while a tab is dragged out of the window -->
            <Popup x:Name="TabGhost" Placement="AbsolutePoint" AllowsTransparency="True" IsHitTestVisible="False" Focusable="False">
                <Border Background="{DynamicResource TabActiveBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Opacity="0.92">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8A7;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,8,0" Foreground="{DynamicResource AccentTextBrush}"/>
                        <TextBlock x:Name="TabGhostText" Foreground="{DynamicResource FgBrush}" FontSize="12" MaxWidth="240" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
            </Popup>
            <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True" VerticalAlignment="Top" Height="40">
                <Button Style="{StaticResource CaptionBtn}" Click="Min_Click"><TextBlock Text="&#xE921;" Style="{StaticResource Glyph}" FontSize="10"/></Button>
                <Button x:Name="MaxButton" Style="{StaticResource CaptionBtn}" Click="Max_Click"><TextBlock x:Name="MaxGlyph" Text="&#xE922;" Style="{StaticResource Glyph}" FontSize="10"/></Button>
                <Button Style="{StaticResource CloseCaptionBtn}" Click="Close_Click"><TextBlock Text="&#xE8BB;" Style="{StaticResource Glyph}" FontSize="10"/></Button>
            </StackPanel>
        </Grid>

        <!-- ============ Address bar on top (optional, Explorer style) + Command bar ============ -->
        <DockPanel Grid.Row="1">
        <Border x:Name="NavHost" DockPanel.Dock="Top" Visibility="Collapsed" Background="{DynamicResource ContentBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"/>
        <Border Background="{DynamicResource BarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,6">
            <DockPanel LastChildFill="False">
                <StackPanel x:Name="CommandsLeft" DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button x:Name="NewBtn" Style="{StaticResource IconBtn}" Click="NewMenu_Click" ToolTip="{v:T NewTip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" FontSize="13" Foreground="{DynamicResource AccentTextBrush}"/>
                            <TextBlock Text="{v:T New}" Margin="8,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="&#xE70D;" Style="{StaticResource Glyph}" FontSize="9"/>
                        </StackPanel>
                    </Button>
                    <Border Width="1" Margin="6,6" Background="{DynamicResource BorderBrush}"/>
                    <Button Style="{StaticResource IconBtn}" Click="Cut_Click" ToolTip="{v:T CutTip}"><TextBlock Text="&#xE8C6;" Style="{StaticResource Glyph}"/></Button>
                    <Button Style="{StaticResource IconBtn}" Click="Copy_Click" ToolTip="{v:T CopyTip}"><TextBlock Text="&#xE8C8;" Style="{StaticResource Glyph}"/></Button>
                    <Button Style="{StaticResource IconBtn}" Click="Paste_Click" ToolTip="{v:T PasteTip}"><TextBlock Text="&#xE77F;" Style="{StaticResource Glyph}"/></Button>
                    <Button Style="{StaticResource IconBtn}" Click="Rename_Click" ToolTip="{v:T RenameTip}"><TextBlock Text="&#xE8AC;" Style="{StaticResource Glyph}"/></Button>
                    <Button Style="{StaticResource IconBtn}" Click="CopyPath_Click" ToolTip="{v:T CopyPathTip}"><TextBlock Text="&#xE71B;" Style="{StaticResource Glyph}"/></Button>
                    <Button Style="{StaticResource IconBtn}" Click="Delete_Click" ToolTip="{v:T DeleteTip}"><TextBlock Text="&#xE74D;" Style="{StaticResource Glyph}"/></Button>
                    <Button Style="{StaticResource IconBtn}" Click="Properties_Click" ToolTip="{v:T PropertiesTip}"><TextBlock Text="&#xE946;" Style="{StaticResource Glyph}"/></Button>
                    <Border Width="1" Margin="6,6" Background="{DynamicResource BorderBrush}"/>
                    <Button x:Name="SortBtn" Style="{StaticResource IconBtn}" Click="SortMenu_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8CB;" Style="{StaticResource Glyph}" FontSize="14"/>
                            <TextBlock Text="{v:T Sort}" Margin="8,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="&#xE70D;" Style="{StaticResource Glyph}" FontSize="9"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ViewBtn" Style="{StaticResource IconBtn}" Click="ViewMenu_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A9;" Style="{StaticResource Glyph}" FontSize="14"/>
                            <TextBlock Text="{v:T View}" Margin="8,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="&#xE70D;" Style="{StaticResource Glyph}" FontSize="9"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <StackPanel x:Name="CommandsRight" Orientation="Horizontal">
                    <ToggleButton x:Name="SplitNone" Style="{StaticResource IconBtn}" Click="Split_Click" Tag="none" ToolTip="{v:T SplitNone}">
                        <Path Data="{StaticResource GeoSingle}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.2" Width="16" Height="14"/>
                    </ToggleButton>
                    <ToggleButton x:Name="SplitV" Style="{StaticResource IconBtn}" Click="Split_Click" Tag="vertical" ToolTip="{v:T SplitVertical}">
                        <Path Data="{StaticResource GeoVertical}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.2" Width="16" Height="14"/>
                    </ToggleButton>
                    <ToggleButton x:Name="SplitH" Style="{StaticResource IconBtn}" Click="Split_Click" Tag="horizontal" ToolTip="{v:T SplitHorizontal}">
                        <Path Data="{StaticResource GeoHorizontal}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.2" Width="16" Height="14"/>
                    </ToggleButton>
                    <Border Width="1" Margin="6,6" Background="{DynamicResource BorderBrush}"/>
                    <ToggleButton x:Name="PreviewToggle" Style="{StaticResource IconBtn}" Click="PreviewToggle_Click" ToolTip="{v:T PreviewTip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A0;" Style="{StaticResource Glyph}"/>
                            <TextBlock Text="{v:T Details}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>
                    <Button Style="{StaticResource IconBtn}" Click="Terminal_Click" ToolTip="{v:T TerminalTip}"><TextBlock Text="&#xE756;" Style="{StaticResource Glyph}"/></Button>
                    </StackPanel>
                    <Button Style="{StaticResource IconBtn}" Click="Donate_Click" ToolTip="{v:T DonateTip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEB52;" Style="{StaticResource Glyph}" Foreground="#E74856"/>
                            <TextBlock Text="{v:T Donate}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="MoreBtn" Style="{StaticResource IconBtn}" Click="MoreMenu_Click" ToolTip="{v:T SettingsTip}"><TextBlock Text="&#xE712;" Style="{StaticResource Glyph}"/></Button>
                </StackPanel>
            </DockPanel>
        </Border>
        </DockPanel>

        <!-- ============ Body ============ -->
        <Grid Grid.Row="2" x:Name="Body" Background="{DynamicResource ContentBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarCol" Width="220" MinWidth="0"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="200"/>
                <ColumnDefinition x:Name="PreviewSplitCol" Width="5"/>
                <ColumnDefinition x:Name="PreviewCol" Width="320" MinWidth="0"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Grid Background="{DynamicResource SidebarBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- while the Settings tab is open the sidebar lists the settings sections -->
                <ListBox x:Name="SettingsNav" Visibility="Collapsed" Background="Transparent" BorderThickness="0" Padding="6,6,6,0"
                         ItemContainerStyle="{StaticResource NavItem}" SelectionChanged="SettingsNav_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="14" Width="26" HorizontalAlignment="Left" TextAlignment="Left"/>
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <ScrollViewer x:Name="SidebarScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="6,6,6,0"
                              AllowDrop="True" MouseRightButtonUp="Sidebar_RightUp" DragOver="Sidebar_DragOver" Drop="Sidebar_Drop" DragLeave="Sidebar_DragLeave" Background="Transparent">
                    <ItemsControl x:Name="SidebarList" ItemTemplate="{StaticResource SidebarTemplate}"
                                  PreviewMouseLeftButtonDown="Sidebar_MouseDown" PreviewMouseMove="Sidebar_MouseMove"
                                  MouseLeftButtonUp="Sidebar_MouseUp" MouseUp="Sidebar_MiddleUp"/>
                </ScrollViewer>
                <Button Grid.Row="1" x:Name="SidebarAddBtn" Style="{StaticResource IconBtn}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="6" Click="SidebarAdd_Click" ToolTip="{v:T AddTip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" FontSize="12" Foreground="{DynamicResource FgDimBrush}"/>
                        <TextBlock Text="{v:T Add}" Margin="10,0,0,0" Foreground="{DynamicResource FgDimBrush}"/>
                    </StackPanel>
                </Button>
            </Grid>
            <GridSplitter Grid.Column="1" Style="{StaticResource Splitter}" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" DragCompleted="Splitter_DragCompleted"/>

            <!-- Tabs content (all tabs stay alive so scroll position etc. is kept) -->
            <ItemsControl Grid.Column="2" x:Name="TabHost" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><Grid/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Visibility" Value="{Binding IsSelected, Converter={StaticResource BoolToVis}}"/>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplateSelector>
                    <v:TabContentSelector>
                        <v:TabContentSelector.Panes>
                            <DataTemplate><v:TabView/></DataTemplate>
                        </v:TabContentSelector.Panes>
                        <v:TabContentSelector.Settings>
                            <DataTemplate><v:SettingsView/></DataTemplate>
                        </v:TabContentSelector.Settings>
                    </v:TabContentSelector>
                </ItemsControl.ItemTemplateSelector>
            </ItemsControl>

            <!-- short notifications ("Moved 3 items to the Recycle Bin – Ctrl+Z to undo") -->
            <Border Grid.Column="2" x:Name="Toast" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,34" Padding="14,9"
                    CornerRadius="6" BorderThickness="1" Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    Visibility="Collapsed" IsHitTestVisible="False" MaxWidth="560">
                <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.3"/></Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE946;" Style="{StaticResource Glyph}" FontSize="14" Margin="0,0,10,0" Foreground="{DynamicResource AccentTextBrush}"/>
                    <TextBlock x:Name="ToastText" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <GridSplitter Grid.Column="3" x:Name="PreviewSplitter" Style="{StaticResource Splitter}" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" DragCompleted="Splitter_DragCompleted"/>
            <v:PreviewPanel Grid.Column="4" x:Name="Preview"/>
        </Grid>
    </Grid>
</Window>
